// Schéma Prisma pour Remoteva
// Base de données SQLite stockée dans /data/remoteva.db

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Utilisateurs administrateurs (salariés EVA)
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

// Projets EVA Flow (captation vidéo)
model FlowProject {
  id        String   @id @default(cuid())
  title     String                          // Titre du projet (ex: "Conf IA 2026")
  date      DateTime                        // Date de captation
  location  String                          // Lieu (ex: "Montpellier")
  room      String                          // Salle (ex: "Amphi A")
  speaker   String   @default("")           // Intervenant(s)
  status    String   @default("planned")    // planned | recording | ingest | ready_to_edit | editing | exported | delivered
  notes     String   @default("")           // Notes libres
  config    String   @default("{}")         // JSON config (chemins, métadonnées futures)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("flow_projects")
}

// Liens d'accès clients
model AccessLink {
  id          String   @id @default(cuid())
  slug        String   @unique // ex: "agrotic2026", "filmscdc"
  serviceType String   @map("service_type") // "newsletter" | "download"
  clientName  String   @map("client_name")
  serviceName String   @map("service_name")
  expiresAt   DateTime @map("expires_at")
  isActive    Boolean  @default(true) @map("is_active")
  config      String   @default("{}") // JSON stocké en string
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("access_links")
}
