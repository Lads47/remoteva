// Schéma Prisma pour Remoteva
// Base de données SQLite stockée dans /data/remoteva.db

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Utilisateurs administrateurs / salariés / formateurs / réalisateurs EVA.
// Phase 4 réorganisation EVA :
//   - status : "pending" (inscription non validée) | "validated"
//   - isSuperAdmin : Lads + Noémie au sommet, peuvent valider les comptes
//     et attribuer les univers.
//   - firstName / lastName : récoltés à l'inscription, optionnels pour les
//     comptes legacy migrés.
//   - universes : table relationnelle UserUniverseAccess (1 ligne = 1 droit).
model AdminUser {
  id           String                @id @default(cuid())
  email        String                @unique
  passwordHash String                @map("password_hash")
  firstName    String?               @map("first_name")
  lastName     String?               @map("last_name")
  status       String                @default("pending")    // pending | validated
  isSuperAdmin Boolean               @default(false) @map("is_super_admin")
  createdAt    DateTime              @default(now()) @map("created_at")
  validatedAt  DateTime?             @map("validated_at")
  universes    UserUniverseAccess[]

  @@map("admin_users")
  @@index([status])
}

// Droit d'accès d'un utilisateur à un univers EVA.
// 1 ligne = 1 droit (lien / newsletter / flow / stream / formations).
// L'absence de ligne = pas d'accès. Les super-admins bypassent ce contrôle.
model UserUniverseAccess {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  universe  String                                         // lien | newsletter | flow | stream | formations
  grantedAt DateTime  @default(now()) @map("granted_at")
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, universe])
  @@map("user_universe_access")
  @@index([userId])
}

// === EVA FLOW : Projets de captation vidéo ===

// Projet = un événement (ex "Journée sur les nuages") qui regroupe plusieurs conférences
model FlowProject {
  id                 String       @id @default(cuid())
  eventId            String       @unique @map("event_id")          // "180426-001" (DDMMYY-NNN)
  title              String                                          // "Journée sur les nuages"
  date               DateTime                                        // Date de captation
  location           String                                          // Ex: "Paris"
  room               String                                          // Ex: "Salle 2"
  speaker            String       @default("")                       // Speaker principal (compat / résumé)
  director           String       @default("")                       // Nom dénormalisé du réalisateur validé
  directorId         String?      @map("director_id")                // FK optionnelle vers Director
  regie              String?                                         // WVP_A1 | WVP_A2 | WVP_A3 | WVP_A4
  recordingLocalPath String?      @map("recording_local_path")       // Dossier racine côté EVA Capture
  status             String       @default("planned")                // Auto-dérivé depuis les conférences
  notes              String       @default("")                       // Notes libres
  config             String       @default("{}")                     // JSON libre
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt      @map("updated_at")
  conferences        Conference[]
  assignedDirector   Director?    @relation(fields: [directorId], references: [id])

  @@map("flow_projects")
  @@index([date])
  @@index([eventId])
  @@index([regie])
  @@index([directorId])
  @@index([status])
}

// Conférence = sous-événement d'un projet (chaque conf est captée et livrée séparément)
model Conference {
  id              String      @id @default(cuid())
  flowProjectId   String      @map("flow_project_id")
  order           Int         @default(1)                            // Ordre dans la journée
  title           String                                              // "Ouverture", "Climat et nuages"...
  speaker         String      @default("")
  status          String      @default("planned")                    // planned | recording | ingest | ready_to_edit | editing | exported | delivered | not_captured
  scheduledStart  DateTime?   @map("scheduled_start")                // Horaire prévu (ex 9h)
  scheduledEnd    DateTime?   @map("scheduled_end")                  // Horaire prévu (ex 10h)
  startTime       DateTime?   @map("start_time")                     // Réel : début du REC
  endTime         DateTime?   @map("end_time")                       // Réel : fin du REC
  localFolder     String?     @map("local_folder")                   // Sous-dossier côté EVA Capture (ex: "conf01_ouverture/")
  durationSeconds Int?        @map("duration_seconds")               // Durée enregistrée
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt      @map("updated_at")
  flowProject     FlowProject @relation(fields: [flowProjectId], references: [id], onDelete: Cascade)

  @@map("flow_conferences")
  @@index([flowProjectId, order])
  @@index([status])
}

// Réalisateur (intermittent qui fait la captation/régie)
model Director {
  id             String                  @id @default(cuid())
  name           String                                              // "Paul Martin"
  email          String                  @unique                     // Pour magic link + feuille de route
  phone          String                  @default("")                // Format libre
  magicToken     String                  @unique @map("magic_token") // Token long pour /presta?token=xxx
  active         Boolean                 @default(true)              // Désactivable sans suppression
  createdAt      DateTime                @default(now()) @map("created_at")
  availabilities DirectorAvailability[]
  projects       FlowProject[]

  @@map("directors")
  @@index([magicToken])
  @@index([active])
}

// Disponibilité d'un réalisateur sur une journée (pas par événement, juste par date)
model DirectorAvailability {
  id         String   @id @default(cuid())
  directorId String   @map("director_id")
  date       DateTime                                                // Date sans heure (00:00 UTC)
  createdAt  DateTime @default(now()) @map("created_at")
  director   Director @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@unique([directorId, date])
  @@map("director_availabilities")
  @@index([date])
}

// API Key pour authentifier les machines EVA Capture / EVA Cut
model ApiKey {
  id         String    @id @default(cuid())
  name       String                                                  // "EVA Capture WVP A1"
  keyHash    String    @unique @map("key_hash")                      // SHA-256(plaintext) hex
  prefix     String                                                  // "evak_a1b2..." (8 chars affichés en UI)
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")                            // Optionnel
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
  @@index([keyHash])
  @@index([revoked])
}

// === FORMATIONS : Catalogue, sessions, stagiaires (organisme Qualiopi) ===

// Formation = produit du catalogue (ex: "Perfectionnement vMix 1J", "Initiation IA")
model Formation {
  id                          String   @id @default(cuid())
  code                        String   @unique                              // "vMix-1J"
  nomLong                     String   @map("nom_long")                     // Libellé commercial complet
  description                 String   @default("")
  prixHT                      Float    @map("prix_ht")
  dureeJours                  Int      @map("duree_jours")
  active                      Boolean  @default(true)
  // Seuil d'inscrits (non "abandonne") à partir duquel la formation est
  // considérée confirmée : déclenche l'envoi auto du contrat de sous-traitance
  // au formateur externe assigné. 0 = désactivé (contrat envoyé manuellement).
  minInscrits                 Int      @default(0) @map("min_inscrits")

  // Sellsy
  sellsyPipelineId            Int?     @map("sellsy_pipeline_id")
  sellsyStepInitial           Int?     @map("sellsy_step_initial")
  sellsyServiceId             Int?     @map("sellsy_service_id")
  sellsyEstimateModelId       Int?     @map("sellsy_estimate_model_id")    // ID du modèle (template) de devis Sellsy
  codeOpportunite             String   @default("") @map("code_opportunite")

  // Google Drive (templates et arbo cible)
  driveDossierRacineId        String?  @map("drive_dossier_racine_id")        // Shared Drive "FORMATION"
  driveDossierSessionsId      String?  @map("drive_dossier_sessions_id")      // Parent où créer les sessions
  driveTemplateProgrammeId    String?  @map("drive_template_programme_id")    // PDF programme
  driveTemplateConventionId   String?  @map("drive_template_convention_id")
  driveTemplateContratId      String?  @map("drive_template_contrat_id")
  driveTemplateConvocationId  String?  @map("drive_template_convocation_id")
  driveTemplateEmargementId   String?  @map("drive_template_emargement_id")
  driveTemplateSuiviId        String?  @map("drive_template_suivi_id")

  configForm                  String   @default("{}") @map("config_form")    // JSON: champs custom du formulaire inscription
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt      @map("updated_at")

  sessions                    Session[]
  evaluationExercises         EvaluationExercise[]
  // Formateurs affectés directement à la formation (indépendamment des sessions).
  // Leur donne accès aux exercices + pré-requis de la formation dans le portail.
  trainerFormations           TrainerFormation[]

  // Override JSON des questions d'éval à chaud (sinon fallback global AppConfig)
  satisfactionConfigForm      String   @default("") @map("satisfaction_config_form")
  // Override JSON des questions d'éval à froid (sinon fallback global AppConfig)
  coldEvalConfigForm          String   @default("") @map("cold_eval_config_form")
  // Override JSON des questions d'éval formateur (sinon fallback global AppConfig)
  trainerEvalConfigForm       String   @default("") @map("trainer_eval_config_form")

  @@map("formations")
  @@index([active])
}

// Session = instance datée d'une formation (ex: vMix-2026-03)
model Session {
  id               String   @id @default(cuid())
  formationId      String   @map("formation_id")
  code             String   @unique                                          // "vMix-2026-03"
  dateDebut        DateTime @map("date_debut")
  dateFin          DateTime @map("date_fin")
  capacite         Int      @default(8)
  lieu             String   @default("")
  horaires         String   @default("")                                      // Format libre "9h-17h30"
  status           String   @default("planned")                              // planned|open|full|closed|cancelled
  driveFolderId    String?  @map("drive_folder_id")                          // Dossier session sur Drive
  driveSuiviFileId String?  @map("drive_suivi_file_id")                      // Sheet de suivi (legacy)
  trainerId        String?  @map("trainer_id")                                // Formateur assigné (optionnel)

  // === Sous-traitance (Qualiopi indicateur 27) ===
  // Si le formateur assigné est externe (Trainer.isExternal = true) on
  // saisit ici le montant HT contractualisé pour CETTE session, on génère
  // un contrat de sous-traitance personnalisé et on garde la trace du
  // fichier Drive généré + de la date d'envoi (audit Qualiopi).
  trainerFeeAmount         Float?    @map("trainer_fee_amount")
  trainerContractDriveFileId String? @map("trainer_contract_drive_file_id")
  trainerContractSentAt    DateTime? @map("trainer_contract_sent_at")
  // Date d'envoi du mail d'assignation au formateur. Garde-fou anti-doublon :
  // le mail part une seule fois, quand la session devient "open" avec un
  // formateur assigné. Remis à null si on change de formateur.
  trainerAssignmentMailSentAt DateTime? @map("trainer_assignment_mail_sent_at")

  notes            String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  formation        Formation @relation(fields: [formationId], references: [id], onDelete: Restrict)
  trainer          Trainer?  @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  trainees         Trainee[]
  attendanceFiles  AttendanceFile[]
  satisfactionResponses SatisfactionResponse[]
  coldEvalResponses     ColdEvalResponse[]
  trainerEvalResponses  TrainerEvalResponse[]
  sponsorEvalResponses  SponsorEvalResponse[]
  complaints            Complaint[]

  @@map("formation_sessions")
  @@index([formationId])
  @@index([dateDebut])
  @@index([status])
  @@index([trainerId])
}

// Trainee = stagiaire inscrit à une session
model Trainee {
  id                       String   @id @default(cuid())
  sessionId                String   @map("session_id")

  // Pipeline (Kanban)
  status                   String   @default("inscrit")
  // inscrit | devis_envoye | devis_signe | convention_envoyee | convention_signee
  // | valide | convoque | en_formation | termine | abandonne

  // Identité
  nom                      String
  prenom                   String
  email                    String
  telephone                String   @default("")

  // Type d'inscription
  inscriptionType          String   @map("inscription_type")                  // particulier | entreprise

  // Volet entreprise
  raisonSociale            String   @default("") @map("raison_sociale")
  siret                    String   @default("")
  adresseSiege             String   @default("") @map("adresse_siege")
  domaineActivite          String   @default("") @map("domaine_activite")
  contactAdmin             String   @default("") @map("contact_admin")        // Référent admin si différent du stagiaire
  referentEmail            String   @default("") @map("referent_email")        // E-mail du référent/commanditaire (enquête satisfaction entreprise)

  // Volet particulier
  adressePostale           String   @default("") @map("adresse_postale")
  statutActuel             String   @default("") @map("statut_actuel")        // Intermittent | Salarié | DE | etc.

  // Financement
  modeFinancement          String   @default("") @map("mode_financement")
  // Via un OPCO | Fonds propres entreprise | AFDAS (Intermittents) | France Travail | Financement personnel
  opcoDetecte              String   @default("") @map("opco_detecte")          // AFDAS | ATLAS | AKTO | ...
  idOpco                   String   @default("") @map("id_opco")               // N° dossier OPCO
  statutDossierFinancement String   @default("") @map("statut_dossier_financement")
  montantHT                Float?   @map("montant_ht")

  // PSH / Adaptations
  psh                      Boolean  @default(false)
  besoinsAdaptation        String   @default("") @map("besoins_adaptation")

  // Stagiaire de test : parcours pleinement fonctionnel (devis, docs…) mais
  // EXCLU de toutes les stats officielles (Qualiopi, BPF, dashboard, résultats
  // publics, non-évalués) et des actions auto (relances, seuil contrat, émargement).
  isTest                   Boolean  @default(false) @map("is_test")

  // Atteinte des objectifs pédagogiques (utilisé pour l'attestation de fin
  // de formation). Si vide, calculé automatiquement depuis les grilles
  // d'évaluation pratique. Sinon, l'admin/formateur a saisi un override
  // manuel ici (cas où les grilles ne reflètent pas la situation réelle).
  // Valeurs : "" (auto) | "atteints" | "partiellement_atteints" | "non_atteints"
  objectifsAtteintsOverride String  @default("") @map("objectifs_atteints_override")

  // Sellsy
  sellsyCompanyId          Int?     @map("sellsy_company_id")
  sellsyIndividualId       Int?     @map("sellsy_individual_id")
  sellsyOpportunityId      Int?     @map("sellsy_opportunity_id")
  sellsyEstimateId         Int?     @map("sellsy_estimate_id")

  // Drive
  driveFolderId            String?  @map("drive_folder_id")                    // Dossier perso du stagiaire dans 01_ENTRANTS

  // Évaluation entrée (JSON libre — varie par formation)
  evalEntree               String   @default("{}") @map("eval_entree")
  attentes                 String   @default("")

  // Jalons
  dateEnvoiDevis           DateTime? @map("date_envoi_devis")
  dateSignatureDevis       DateTime? @map("date_signature_devis")
  dateEnvoiConvention      DateTime? @map("date_envoi_convention")
  dateSignatureConvention  DateTime? @map("date_signature_convention")
  dateConvocation          DateTime? @map("date_convocation")

  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt      @map("updated_at")

  session                  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  documents                TraineeDocument[]
  events                   TraineeEvent[]
  attendances              Attendance[]
  exerciseEvaluations      TraineeExerciseEvaluation[]
  satisfactionResponses    SatisfactionResponse[]
  coldEvalResponses        ColdEvalResponse[]
  complaints               Complaint[]

  @@map("trainees")
  @@index([sessionId])
  @@index([status])
  @@index([email])
}

// Document généré ou reçu pour un stagiaire (devis, convention, convocation, etc.)
model TraineeDocument {
  id           String    @id @default(cuid())
  traineeId    String    @map("trainee_id")
  type         String                                                          // devis | convention | contrat | convocation | emargement | attestation | programme | tuto_opco | other
  driveFileId  String    @map("drive_file_id")
  driveFileUrl String    @default("") @map("drive_file_url")
  fileName     String    @map("file_name")
  generatedAt  DateTime  @default(now()) @map("generated_at")
  sentAt       DateTime? @map("sent_at")
  signedAt     DateTime? @map("signed_at")

  trainee      Trainee   @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@map("trainee_documents")
  @@index([traineeId])
  @@index([type])
}

// Dépôt de fichiers d'émargement signés (PDF scannés / photos) pour archive Qualiopi.
// Stockage sur disque dans /app/data/attendance-files/ (volume Docker persisté).
model AttendanceFile {
  id           String   @id @default(cuid())
  sessionId    String   @map("session_id")
  date         DateTime?                                                   // Optionnel : jour signé associé
  filename     String                                                       // Nom original (pour affichage / download)
  storagePath  String   @map("storage_path")                                // Chemin relatif sur disque (uuid.ext)
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedById String?  @map("uploaded_by_id")                              // Trainer qui a déposé
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  // Sync Drive (best-effort)
  driveFileId    String?  @map("drive_file_id")
  driveWebUrl    String?  @map("drive_web_url")
  driveSyncedAt  DateTime? @map("drive_synced_at")
  driveSyncError String?   @map("drive_sync_error")                         // Message d'erreur si dernière sync KO

  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  uploadedBy   Trainer? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("attendance_files")
  @@index([sessionId])
  @@index([date])
}

// Émargement : présence d'un stagiaire pour une demi-journée donnée d'une session
model Attendance {
  id          String   @id @default(cuid())
  traineeId   String   @map("trainee_id")
  date        DateTime                                                      // Date à 00:00 UTC du jour
  slot        String                                                        // "morning" | "afternoon"
  status      String                                                        // "present" | "absent"
  notes       String   @default("")
  signedById  String?  @map("signed_by_id")                                 // FK Trainer (qui a saisi)
  signedAt    DateTime @default(now()) @map("signed_at")

  trainee     Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  signedBy    Trainer? @relation(fields: [signedById], references: [id], onDelete: SetNull)

  @@unique([traineeId, date, slot])
  @@map("attendances")
  @@index([traineeId])
  @@index([date])
}

// Journal d'événements pour audit Qualiopi (timeline du stagiaire)
model TraineeEvent {
  id        String   @id @default(cuid())
  traineeId String   @map("trainee_id")
  type      String                                                              // status_change | doc_generated | doc_sent | email_sent | sellsy_synced | note
  payload   String   @default("{}")                                             // JSON
  message   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  trainee   Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@map("trainee_events")
  @@index([traineeId, createdAt])
}

// Formateur (intermittent ou interne qui anime une session de formation)
model Trainer {
  id          String   @id @default(cuid())
  nom         String
  prenom      String
  email       String   @unique
  telephone   String   @default("")
  magicToken  String   @unique @map("magic_token")
  active      Boolean  @default(true)

  // Lien vers le dossier Drive contenant les CV, qualifications, certifications
  // et expériences pédagogiques du formateur (Qualiopi indicateur 21).
  // Permet à l'admin de présenter les pièces lors d'un audit en un clic.
  driveCvFolderId String? @map("drive_cv_folder_id")

  // Champ libre pour résumer la qualification principale du formateur, son
  // domaine d'expertise et son expérience pertinente — utile pour audit
  // rapide sans devoir ouvrir le Drive (Qualiopi indicateur 21).
  qualifications  String  @default("")

  // Champ libre pour documenter les actions de maintien et développement
  // des compétences sur l'année : formations suivies, webinaires,
  // certifications obtenues, événements pro, abonnements de veille
  // (Qualiopi indicateur 22). À mettre à jour annuellement.
  developpementCompetences String @default("") @map("developpement_competences")

  // === Formateur externe / sous-traitant (Qualiopi indicateur 27) ===
  // Si true, à chaque assignation à une session on génère un contrat de
  // sous-traitance personnalisé (montant saisi à l'assignation) et on
  // l'envoie en PJ du mail "session assignée". Les 5 champs ci-dessous
  // alimentent les variables du template du contrat.
  isExternal        Boolean @default(false) @map("is_external")
  raisonSociale     String  @default("")    @map("raison_sociale")
  siret             String  @default("")
  adresse           String  @default("")
  numeroDa          String  @default("")    @map("numero_da")           // N° de déclaration d'activité (si OF déclaré)
  representantLegal String  @default("")    @map("representant_legal") // si différent du formateur (ex: gérant SARL)

  createdAt   DateTime @default(now()) @map("created_at")

  sessions             Session[]
  attendancesSigned    Attendance[]
  attendanceFilesUploaded AttendanceFile[]
  evaluationsAuthored  TraineeExerciseEvaluation[]
  trainerEvalResponses TrainerEvalResponse[]
  // Formations affectées directement à ce formateur (cf. Formation.trainerFormations)
  trainerFormations    TrainerFormation[]

  @@map("trainers")
  @@index([magicToken])
  @@index([active])
}

// Affectation directe d'un formateur à une formation (table de jointure).
// Indépendante des sessions : permet à un formateur d'accéder aux exercices
// et pré-requis d'une formation même sans session encore assignée. L'accès
// "formation" du portail formateur = union (sessions assignées + affectations directes).
model TrainerFormation {
  trainerId   String   @map("trainer_id")
  formationId String   @map("formation_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  trainer   Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  formation Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@id([trainerId, formationId])
  @@map("trainer_formations")
  @@index([formationId])
}

// === RÉCLAMATIONS (Qualiopi indicateur 32) ===
//
// Canal de signalement public pour les bénéficiaires, prescripteurs et
// partenaires. Engagement réglementaire : traitement sous 30 jours.
//
// Section 1 (champs *Author*, *Concerned*, subject, description) : saisie par
// le réclamant via /reclamation. Section 2 (status, response*, resolvedAt,
// actionCorrective) : remplie par l'admin lors du traitement.

model Complaint {
  id                    String    @id @default(cuid())

  // Numéro lisible auto-généré : RECL-2026-001
  number                String    @unique

  // === Section réclamant ===
  authorName            String    @map("author_name")
  authorCompany         String    @default("") @map("author_company")
  authorRole            String    @default("") @map("author_role")
  authorEmail           String    @map("author_email")

  // Si la réclamation concerne quelqu'un d'autre (ex: employeur qui réclame
  // pour son salarié), on capture aussi ses coordonnées. Sinon vide.
  concernedName         String    @default("") @map("concerned_name")
  concernedCompany      String    @default("") @map("concerned_company")
  concernedRole         String    @default("") @map("concerned_role")

  subject               String                              // Objet précis
  description           String                              // Description explicite (dysfonctionnement, date, lieu, intervenants…)

  // Optionnels : si le réclamant a pu identifier la session ou le stagiaire concerné
  sessionId             String?   @map("session_id")
  traineeId             String?   @map("trainee_id")

  // === Section admin ===
  receptionMode         String    @default("formulaire_web") @map("reception_mode")  // formulaire_web | email | courrier | telephone
  status                String    @default("new")                                    // new | in_progress | resolved | closed
  responseType          String    @default("") @map("response_type")                 // email | telephone | courrier
  responseContent       String    @default("") @map("response_content")              // Texte de la réponse adressée au réclamant
  actionCorrective      String    @default("") @map("action_corrective")             // Actions mises en place — indicateur Qualiopi
  responseSentAt        DateTime? @map("response_sent_at")
  resolvedAt            DateTime? @map("resolved_at")
  resolvedBy            String    @default("") @map("resolved_by")                   // Email/nom de la personne qui a clôturé
  adminNotes            String    @default("") @map("admin_notes")                   // Notes internes admin

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt      @map("updated_at")

  session  Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  trainee  Trainee? @relation(fields: [traineeId], references: [id], onDelete: SetNull)

  @@map("complaints")
  @@index([status])
  @@index([createdAt])
  @@index([sessionId])
  @@index([traineeId])
}

// === Configuration globale (clé/valeur) ===

// Stocke des paramètres applicatifs partagés (mapping Sellsy, etc.).
// `value` est libre — souvent du JSON sérialisé en string.
model AppConfig {
  key       String   @id
  value     String                                                // JSON ou texte simple
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

// === Liens d'accès clients (Newsletter / Download) ===

model AccessLink {
  id          String   @id @default(cuid())
  slug        String   @unique // ex: "agrotic2026", "filmscdc"
  serviceType String   @map("service_type") // "newsletter" | "download"
  clientName  String   @map("client_name")
  serviceName String   @map("service_name")
  expiresAt   DateTime @map("expires_at")
  isActive    Boolean  @default(true) @map("is_active")
  config      String   @default("{}") // JSON stocké en string
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("access_links")
}

// === GRILLES D'ÉVALUATION PRATIQUE (Qualiopi) ===
//
// Hiérarchie : Formation > Exercices > Critères
// Le formateur évalue chaque stagiaire sur chaque exercice avec une note
// (acquis / en_cours / non_acquis) par critère + observations globales.
// Une fiche PDF de synthèse est archivée dans 03_EVALUATIONS sur Drive.

// Exercice pratique défini au niveau de la formation
// (ex: "Exercice 1 : Captation multicaméra live")
model EvaluationExercise {
  id          String   @id @default(cuid())
  formationId String   @map("formation_id")
  ordre       Int      @default(1)                                // Ordre d'affichage (lex tri)
  titre       String                                              // Intitulé de l'exercice
  description String   @default("")                               // Objectif / énoncé / contexte
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  formation   Formation             @relation(fields: [formationId], references: [id], onDelete: Cascade)
  criteria    EvaluationCriterion[]
  evaluations TraineeExerciseEvaluation[]

  @@map("evaluation_exercises")
  @@index([formationId, ordre])
  @@index([active])
}

// Critère d'évaluation à l'intérieur d'un exercice
// (ex: "Maîtrise des transitions vidéo", "Gestion du son")
model EvaluationCriterion {
  id          String   @id @default(cuid())
  exerciseId  String   @map("exercise_id")
  ordre       Int      @default(1)
  libelle     String                                              // Intitulé du critère
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  exercise    EvaluationExercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  scores      TraineeCriterionScore[]

  @@map("evaluation_criteria")
  @@index([exerciseId, ordre])
}

// Évaluation d'un stagiaire pour un exercice donné (= une fiche d'évaluation)
// `globalNote` est la synthèse formateur (acquis / en_cours / non_acquis).
// Une fiche par (stagiaire, exercice) — unique.
model TraineeExerciseEvaluation {
  id            String    @id @default(cuid())
  traineeId     String    @map("trainee_id")
  exerciseId    String    @map("exercise_id")
  evaluatorId   String?   @map("evaluator_id")                    // Formateur qui a évalué
  globalNote    String    @default("") @map("global_note")        // "acquis" | "en_cours" | "non_acquis" | ""
  observations  String    @default("")                            // Commentaire libre formateur
  evaluatedAt   DateTime  @default(now()) @map("evaluated_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")

  // Sync Drive (PDF synthèse)
  driveFileId    String?   @map("drive_file_id")
  driveWebUrl    String?   @map("drive_web_url")
  driveSyncedAt  DateTime? @map("drive_synced_at")
  driveSyncError String?   @map("drive_sync_error")

  trainee       Trainee                @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  exercise      EvaluationExercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  evaluator     Trainer?               @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)
  scores        TraineeCriterionScore[]

  @@unique([traineeId, exerciseId])
  @@map("trainee_exercise_evaluations")
  @@index([traineeId])
  @@index([exerciseId])
}

// === ÉVALUATION À CHAUD (satisfaction stagiaire fin de session) ===
//
// Une invitation est créée par stagiaire lors de l'envoi de l'enquête (via
// le bouton du formateur). Le stagiaire répond via un lien magic-token ou
// après avoir scanné le QR code de la session (qui mène à une page de
// sélection puis au formulaire personnel).
//
// Les questions sont snapshotées au moment de l'envoi pour préserver le
// contexte de réponse si la config questions évolue ensuite.

model SatisfactionResponse {
  id                String    @id @default(cuid())
  sessionId         String    @map("session_id")
  // Pour les nouvelles soumissions (anonymes), traineeId et magicToken sont
  // null. Conservés en option pour rétrocompatibilité des anciennes données.
  traineeId         String?   @map("trainee_id")
  magicToken        String?   @unique @map("magic_token")
  questionsSnapshot String    @map("questions_snapshot")   // JSON : array SatisfactionQuestion[]
  invitedAt         DateTime  @default(now()) @map("invited_at")
  submittedAt       DateTime? @map("submitted_at")

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainee  Trainee? @relation(fields: [traineeId], references: [id], onDelete: SetNull)
  answers  SatisfactionAnswer[]

  @@map("satisfaction_responses")
  @@index([sessionId])
  @@index([traineeId])
  @@index([magicToken])
}

model SatisfactionAnswer {
  id           String @id @default(cuid())
  responseId   String @map("response_id")
  questionName String @map("question_name")   // identifiant interne (cf. SatisfactionQuestion.name)
  value        String                          // sérialisation : nombre, texte, ou JSON.array

  response SatisfactionResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("satisfaction_answers")
  @@index([responseId])
}

// === ÉVALUATION À FROID (impact en poste, 3 mois après) ===
//
// Contrairement au chaud (anonyme), l'éval à froid identifie le stagiaire :
//   - magic-token personnel pour traquer qui a répondu
//   - relances automatiques J+7 et J+14 si pas répondu
//
// Une invitation = une ligne ColdEvalResponse créée par stagiaire par le cron
// 3 mois après la fin de session. `submittedAt` reste null jusqu'à la soumission.
// Les snapshots de questions sont conservés pour préserver le contexte.

model ColdEvalResponse {
  id                String    @id @default(cuid())
  sessionId         String    @map("session_id")
  traineeId         String    @map("trainee_id")
  magicToken        String    @unique @map("magic_token")
  questionsSnapshot String    @map("questions_snapshot")     // JSON : array SatisfactionQuestion[]
  invitedAt         DateTime  @default(now()) @map("invited_at")
  reminder1At       DateTime? @map("reminder_1_at")           // J+7 si pas répondu
  reminder2At       DateTime? @map("reminder_2_at")           // J+14 si pas répondu
  submittedAt       DateTime? @map("submitted_at")

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainee  Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  answers  ColdEvalAnswer[]

  @@map("cold_eval_responses")
  @@unique([sessionId, traineeId])
  @@index([sessionId])
  @@index([traineeId])
  @@index([magicToken])
  @@index([submittedAt])
}

model ColdEvalAnswer {
  id           String @id @default(cuid())
  responseId   String @map("response_id")
  questionName String @map("question_name")
  value        String

  response ColdEvalResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("cold_eval_answers")
  @@index([responseId])
}

// === SATISFACTION COMMANDITAIRE / ENTREPRISE (Qualiopi indicateur 2) ===
//
// Recueil des appréciations de l'entreprise commanditaire (le référent qui a
// inscrit ses salariés). 1 enquête par entreprise (référent) et par session,
// envoyée en même temps que l'éval à froid stagiaire (même délai), avec
// relances J+7 / J+14. Pattern identique à ColdEvalResponse mais le
// destinataire est un contact entreprise (email dénormalisé), pas un Trainee.

model SponsorEvalResponse {
  id                String    @id @default(cuid())
  sessionId         String    @map("session_id")
  companyName       String    @default("") @map("company_name")   // Raison sociale (dénormalisée)
  contactEmail      String    @map("contact_email")                // E-mail du référent commanditaire
  contactName       String    @default("") @map("contact_name")    // Nom du référent (si connu)
  magicToken        String    @unique @map("magic_token")
  questionsSnapshot String    @map("questions_snapshot")
  invitedAt         DateTime  @default(now()) @map("invited_at")
  reminder1At       DateTime? @map("reminder_1_at")
  reminder2At       DateTime? @map("reminder_2_at")
  submittedAt       DateTime? @map("submitted_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers SponsorEvalAnswer[]

  @@map("sponsor_eval_responses")
  @@unique([sessionId, contactEmail])
  @@index([sessionId])
  @@index([magicToken])
  @@index([submittedAt])
}

model SponsorEvalAnswer {
  id           String @id @default(cuid())
  responseId   String @map("response_id")
  questionName String @map("question_name")
  value        String

  response SponsorEvalResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("sponsor_eval_answers")
  @@index([responseId])
}

// === ÉVALUATION FORMATEUR (bilan formateur fin de session) ===
//
// Le formateur reçoit un mail J+1 après la dateFin de session avec un lien
// magic-token personnel vers un formulaire de bilan. Relances auto à J+7
// et J+14 si pas répondu. Pattern identique à ColdEvalResponse.

model TrainerEvalResponse {
  id                String    @id @default(cuid())
  sessionId         String    @map("session_id")
  trainerId         String    @map("trainer_id")
  magicToken        String    @unique @map("magic_token")
  questionsSnapshot String    @map("questions_snapshot")
  invitedAt         DateTime  @default(now()) @map("invited_at")
  reminder1At       DateTime? @map("reminder_1_at")
  reminder2At       DateTime? @map("reminder_2_at")
  submittedAt       DateTime? @map("submitted_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  answers TrainerEvalAnswer[]

  @@map("trainer_eval_responses")
  @@unique([sessionId, trainerId])
  @@index([sessionId])
  @@index([trainerId])
  @@index([magicToken])
  @@index([submittedAt])
}

model TrainerEvalAnswer {
  id           String @id @default(cuid())
  responseId   String @map("response_id")
  questionName String @map("question_name")
  value        String

  response TrainerEvalResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("trainer_eval_answers")
  @@index([responseId])
}

// Note d'un stagiaire sur un critère donné, dans le cadre d'une évaluation d'exercice.
// Valeurs autorisées pour `score` : "acquis" | "en_cours" | "non_acquis" | "" (vide = non noté)
model TraineeCriterionScore {
  id           String   @id @default(cuid())
  evaluationId String   @map("evaluation_id")
  criterionId  String   @map("criterion_id")
  score        String   @default("")                              // 3-niveau Qualiopi
  comment      String   @default("")

  evaluation   TraineeExerciseEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion    EvaluationCriterion       @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
  @@map("trainee_criterion_scores")
  @@index([criterionId])
}

// === EVA MASTER : Prestas de captation → livrables ===
//
// Structure PROPRE à EVA MASTER, distincte des tables flow_* (EVA STUDIO).
// Une presta = un événement filmé (ex "CDC — 20 et 21 juin") qui regroupe
// plusieurs conférences à marquer (début/fin) puis à transformer en films /
// shorts / newsletter. La communication avec EVA CORE (transcription, résumés)
// est stubbée en v1 : ces tables stockent la COPIE serveur ; la source de
// vérité du marquage reste côté régie (IndexedDB navigateur, hors-ligne).

// Une presta adressable par slug via /admin/master/[slug].
model MasterPresta {
  id          String              @id @default(cuid())
  slug        String              @unique                       // ex "cdc-20-21-juin"
  name        String                                            // "CDC — 20 et 21 juin"
  driveUrl    String              @map("drive_url")             // lien du dossier Drive source
  driveStatus String              @default("pending") @map("drive_status") // pending | read (lu par EVA CORE : lexique + jingles prêts)
  createdAt   DateTime            @default(now()) @map("created_at")

  conferences MasterConference[]
  vmixLogs    MasterVmixLog[]

  @@map("master_prestas")
}

// Une conférence d'une presta. `position` = numéro affiché ; l'ordre réel
// prime sur l'ordre planifié (confs ajoutées/annulées/déplacées en direct).
// startedAt / endedAt = copie serveur du marquage (reçue à l'envoi manuel).
model MasterConference {
  id        String       @id @default(cuid())
  prestaId  String       @map("presta_id")
  position  Int                                                 // numéro affiché (1, 2, 3…)
  title     String
  speakers  String       @default("[]")                         // JSON: intervenants (issus du sheet)
  status    String       @default("pending")                    // pending | recording | done | cancelled
  startedAt DateTime?    @map("started_at")                     // marquage début (copie serveur)
  endedAt   DateTime?    @map("ended_at")                       // marquage fin (copie serveur)
  createdAt DateTime     @default(now()) @map("created_at")

  presta    MasterPresta @relation(fields: [prestaId], references: [id], onDelete: Cascade)

  @@map("master_conferences")
  @@index([prestaId])
}

// Fichier .log vMix déposé par l'opérateur, destiné à EVA CORE + module XML.
// Stocké sur disque ; `sent` passe à true après l'envoi groupé.
model MasterVmixLog {
  id          String       @id @default(cuid())
  prestaId    String       @map("presta_id")
  filename    String                                            // nom d'origine du .log
  size        Int                                               // octets
  storagePath String       @map("storage_path")                // chemin disque côté serveur
  sent        Boolean      @default(false)                      // envoyé à EVA Core ?
  uploadedAt  DateTime     @default(now()) @map("uploaded_at")

  presta      MasterPresta @relation(fields: [prestaId], references: [id], onDelete: Cascade)

  @@map("master_vmix_logs")
  @@index([prestaId])
}
