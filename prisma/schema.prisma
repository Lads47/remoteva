// Schéma Prisma pour Remoteva
// Base de données SQLite stockée dans /data/remoteva.db

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Utilisateurs administrateurs (salariés EVA)
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

// === EVA FLOW : Projets de captation vidéo ===

// Projet = un événement (ex "Journée sur les nuages") qui regroupe plusieurs conférences
model FlowProject {
  id                 String       @id @default(cuid())
  eventId            String       @unique @map("event_id")          // "180426-001" (DDMMYY-NNN)
  title              String                                          // "Journée sur les nuages"
  date               DateTime                                        // Date de captation
  location           String                                          // Ex: "Paris"
  room               String                                          // Ex: "Salle 2"
  speaker            String       @default("")                       // Speaker principal (compat / résumé)
  director           String       @default("")                       // Nom dénormalisé du réalisateur validé
  directorId         String?      @map("director_id")                // FK optionnelle vers Director
  regie              String?                                         // WVP_A1 | WVP_A2 | WVP_A3 | WVP_A4
  recordingLocalPath String?      @map("recording_local_path")       // Dossier racine côté EVA Capture
  status             String       @default("planned")                // Auto-dérivé depuis les conférences
  notes              String       @default("")                       // Notes libres
  config             String       @default("{}")                     // JSON libre
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt      @map("updated_at")
  conferences        Conference[]
  assignedDirector   Director?    @relation(fields: [directorId], references: [id])

  @@map("flow_projects")
  @@index([date])
  @@index([eventId])
  @@index([regie])
  @@index([directorId])
  @@index([status])
}

// Conférence = sous-événement d'un projet (chaque conf est captée et livrée séparément)
model Conference {
  id              String      @id @default(cuid())
  flowProjectId   String      @map("flow_project_id")
  order           Int         @default(1)                            // Ordre dans la journée
  title           String                                              // "Ouverture", "Climat et nuages"...
  speaker         String      @default("")
  status          String      @default("planned")                    // planned | recording | ingest | ready_to_edit | editing | exported | delivered | not_captured
  scheduledStart  DateTime?   @map("scheduled_start")                // Horaire prévu (ex 9h)
  scheduledEnd    DateTime?   @map("scheduled_end")                  // Horaire prévu (ex 10h)
  startTime       DateTime?   @map("start_time")                     // Réel : début du REC
  endTime         DateTime?   @map("end_time")                       // Réel : fin du REC
  localFolder     String?     @map("local_folder")                   // Sous-dossier côté EVA Capture (ex: "conf01_ouverture/")
  durationSeconds Int?        @map("duration_seconds")               // Durée enregistrée
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt      @map("updated_at")
  flowProject     FlowProject @relation(fields: [flowProjectId], references: [id], onDelete: Cascade)

  @@map("flow_conferences")
  @@index([flowProjectId, order])
  @@index([status])
}

// Réalisateur (intermittent qui fait la captation/régie)
model Director {
  id             String                  @id @default(cuid())
  name           String                                              // "Paul Martin"
  email          String                  @unique                     // Pour magic link + feuille de route
  phone          String                  @default("")                // Format libre
  magicToken     String                  @unique @map("magic_token") // Token long pour /presta?token=xxx
  active         Boolean                 @default(true)              // Désactivable sans suppression
  createdAt      DateTime                @default(now()) @map("created_at")
  availabilities DirectorAvailability[]
  projects       FlowProject[]

  @@map("directors")
  @@index([magicToken])
  @@index([active])
}

// Disponibilité d'un réalisateur sur une journée (pas par événement, juste par date)
model DirectorAvailability {
  id         String   @id @default(cuid())
  directorId String   @map("director_id")
  date       DateTime                                                // Date sans heure (00:00 UTC)
  createdAt  DateTime @default(now()) @map("created_at")
  director   Director @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@unique([directorId, date])
  @@map("director_availabilities")
  @@index([date])
}

// API Key pour authentifier les machines EVA Capture / EVA Cut
model ApiKey {
  id         String    @id @default(cuid())
  name       String                                                  // "EVA Capture WVP A1"
  keyHash    String    @unique @map("key_hash")                      // SHA-256(plaintext) hex
  prefix     String                                                  // "evak_a1b2..." (8 chars affichés en UI)
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")                            // Optionnel
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
  @@index([keyHash])
  @@index([revoked])
}

// === FORMATIONS : Catalogue, sessions, stagiaires (organisme Qualiopi) ===

// Formation = produit du catalogue (ex: "Perfectionnement vMix 1J", "Initiation IA")
model Formation {
  id                          String   @id @default(cuid())
  code                        String   @unique                              // "vMix-1J"
  nomLong                     String   @map("nom_long")                     // Libellé commercial complet
  description                 String   @default("")
  prixHT                      Float    @map("prix_ht")
  dureeJours                  Int      @map("duree_jours")
  active                      Boolean  @default(true)

  // Sellsy
  sellsyPipelineId            Int?     @map("sellsy_pipeline_id")
  sellsyStepInitial           Int?     @map("sellsy_step_initial")
  sellsyServiceId             Int?     @map("sellsy_service_id")
  sellsyEstimateModelId       Int?     @map("sellsy_estimate_model_id")    // ID du modèle (template) de devis Sellsy
  codeOpportunite             String   @default("") @map("code_opportunite")

  // Google Drive (templates et arbo cible)
  driveDossierRacineId        String?  @map("drive_dossier_racine_id")        // Shared Drive "FORMATION"
  driveDossierSessionsId      String?  @map("drive_dossier_sessions_id")      // Parent où créer les sessions
  driveTemplateProgrammeId    String?  @map("drive_template_programme_id")    // PDF programme
  driveTemplateConventionId   String?  @map("drive_template_convention_id")
  driveTemplateContratId      String?  @map("drive_template_contrat_id")
  driveTemplateConvocationId  String?  @map("drive_template_convocation_id")
  driveTemplateEmargementId   String?  @map("drive_template_emargement_id")
  driveTemplateSuiviId        String?  @map("drive_template_suivi_id")

  configForm                  String   @default("{}") @map("config_form")    // JSON: champs custom du formulaire inscription
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt      @map("updated_at")

  sessions                    Session[]

  @@map("formations")
  @@index([active])
}

// Session = instance datée d'une formation (ex: vMix-2026-03)
model Session {
  id               String   @id @default(cuid())
  formationId      String   @map("formation_id")
  code             String   @unique                                          // "vMix-2026-03"
  dateDebut        DateTime @map("date_debut")
  dateFin          DateTime @map("date_fin")
  capacite         Int      @default(8)
  lieu             String   @default("")
  horaires         String   @default("")                                      // Format libre "9h-17h30"
  status           String   @default("planned")                              // planned|open|full|closed|cancelled
  driveFolderId    String?  @map("drive_folder_id")                          // Dossier session sur Drive
  driveSuiviFileId String?  @map("drive_suivi_file_id")                      // Sheet de suivi (legacy)
  trainerId        String?  @map("trainer_id")                                // Formateur assigné (optionnel)
  notes            String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  formation        Formation @relation(fields: [formationId], references: [id], onDelete: Restrict)
  trainer          Trainer?  @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  trainees         Trainee[]

  @@map("formation_sessions")
  @@index([formationId])
  @@index([dateDebut])
  @@index([status])
  @@index([trainerId])
}

// Trainee = stagiaire inscrit à une session
model Trainee {
  id                       String   @id @default(cuid())
  sessionId                String   @map("session_id")

  // Pipeline (Kanban)
  status                   String   @default("inscrit")
  // inscrit | devis_envoye | devis_signe | convention_envoyee | convention_signee
  // | valide | convoque | en_formation | termine | abandonne

  // Identité
  nom                      String
  prenom                   String
  email                    String
  telephone                String   @default("")

  // Type d'inscription
  inscriptionType          String   @map("inscription_type")                  // particulier | entreprise

  // Volet entreprise
  raisonSociale            String   @default("") @map("raison_sociale")
  siret                    String   @default("")
  adresseSiege             String   @default("") @map("adresse_siege")
  domaineActivite          String   @default("") @map("domaine_activite")
  contactAdmin             String   @default("") @map("contact_admin")        // Référent admin si différent du stagiaire

  // Volet particulier
  adressePostale           String   @default("") @map("adresse_postale")
  statutActuel             String   @default("") @map("statut_actuel")        // Intermittent | Salarié | DE | etc.

  // Financement
  modeFinancement          String   @default("") @map("mode_financement")
  // Via un OPCO | Fonds propres entreprise | AFDAS (Intermittents) | France Travail | Financement personnel
  opcoDetecte              String   @default("") @map("opco_detecte")          // AFDAS | ATLAS | AKTO | ...
  idOpco                   String   @default("") @map("id_opco")               // N° dossier OPCO
  statutDossierFinancement String   @default("") @map("statut_dossier_financement")
  montantHT                Float?   @map("montant_ht")

  // PSH / Adaptations
  psh                      Boolean  @default(false)
  besoinsAdaptation        String   @default("") @map("besoins_adaptation")

  // Sellsy
  sellsyCompanyId          Int?     @map("sellsy_company_id")
  sellsyIndividualId       Int?     @map("sellsy_individual_id")
  sellsyOpportunityId      Int?     @map("sellsy_opportunity_id")
  sellsyEstimateId         Int?     @map("sellsy_estimate_id")

  // Drive
  driveFolderId            String?  @map("drive_folder_id")                    // Dossier perso du stagiaire dans 01_ENTRANTS

  // Évaluation entrée (JSON libre — varie par formation)
  evalEntree               String   @default("{}") @map("eval_entree")
  attentes                 String   @default("")

  // Jalons
  dateEnvoiDevis           DateTime? @map("date_envoi_devis")
  dateSignatureDevis       DateTime? @map("date_signature_devis")
  dateEnvoiConvention      DateTime? @map("date_envoi_convention")
  dateSignatureConvention  DateTime? @map("date_signature_convention")
  dateConvocation          DateTime? @map("date_convocation")

  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt      @map("updated_at")

  session                  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  documents                TraineeDocument[]
  events                   TraineeEvent[]

  @@map("trainees")
  @@index([sessionId])
  @@index([status])
  @@index([email])
}

// Document généré ou reçu pour un stagiaire (devis, convention, convocation, etc.)
model TraineeDocument {
  id           String    @id @default(cuid())
  traineeId    String    @map("trainee_id")
  type         String                                                          // devis | convention | contrat | convocation | emargement | attestation | programme | tuto_opco | other
  driveFileId  String    @map("drive_file_id")
  driveFileUrl String    @default("") @map("drive_file_url")
  fileName     String    @map("file_name")
  generatedAt  DateTime  @default(now()) @map("generated_at")
  sentAt       DateTime? @map("sent_at")
  signedAt     DateTime? @map("signed_at")

  trainee      Trainee   @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@map("trainee_documents")
  @@index([traineeId])
  @@index([type])
}

// Journal d'événements pour audit Qualiopi (timeline du stagiaire)
model TraineeEvent {
  id        String   @id @default(cuid())
  traineeId String   @map("trainee_id")
  type      String                                                              // status_change | doc_generated | doc_sent | email_sent | sellsy_synced | note
  payload   String   @default("{}")                                             // JSON
  message   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  trainee   Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@map("trainee_events")
  @@index([traineeId, createdAt])
}

// Formateur (intermittent ou interne qui anime une session de formation)
model Trainer {
  id          String   @id @default(cuid())
  nom         String
  prenom      String
  email       String   @unique
  telephone   String   @default("")
  magicToken  String   @unique @map("magic_token")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  sessions    Session[]

  @@map("trainers")
  @@index([magicToken])
  @@index([active])
}

// === Configuration globale (clé/valeur) ===

// Stocke des paramètres applicatifs partagés (mapping Sellsy, etc.).
// `value` est libre — souvent du JSON sérialisé en string.
model AppConfig {
  key       String   @id
  value     String                                                // JSON ou texte simple
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

// === Liens d'accès clients (Newsletter / Download) ===

model AccessLink {
  id          String   @id @default(cuid())
  slug        String   @unique // ex: "agrotic2026", "filmscdc"
  serviceType String   @map("service_type") // "newsletter" | "download"
  clientName  String   @map("client_name")
  serviceName String   @map("service_name")
  expiresAt   DateTime @map("expires_at")
  isActive    Boolean  @default(true) @map("is_active")
  config      String   @default("{}") // JSON stocké en string
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("access_links")
}
