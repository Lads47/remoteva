[Unit]
Description=SRT Live Server (SLS) hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=srtadmin
Group=srtadmin
ExecStart=/usr/local/bin/sls -c /etc/sls/sls.conf
Restart=always
RestartSec=5
LimitNOFILE=65536
StandardOutput=append:/var/log/sls/stdout.log
StandardError=append:/var/log/sls/stderr.log
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
