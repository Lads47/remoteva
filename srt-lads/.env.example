# ============================================================
# SRT LADS - Environment variables template
# Copy this file to .env on the server and fill in real values
# NEVER commit .env to git
# ============================================================

# GitHub
GITHUB_TOKEN=

# Web interface (used in Phase 2)
ADMIN_WEB_USER=admin
ADMIN_WEB_PASSWORD=
WEB_PORT=3000
WEB_SESSION_SECRET=

# SLS (SRT Live Server)
SLS_STATS_PORT=8181
SLS_LOG_PATH=/var/log/sls
SLS_DEFAULT_LATENCY=300

# Mumble
MUMBLE_SUPERUSER_PASSWORD=

# Paths
DATA_PATH=/var/lib/srt-lads
PROJECTS_PATH=/var/lib/srt-lads/projects
