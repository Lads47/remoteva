      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst to = body.to || '';\nconst directorName = body.directorName || 'Réalisateur';\nconst magicLink = body.magicLink || 'https://evaremote.com/presta';\n\nconst subject = `Bienvenue sur EVA Flow — Votre accès personnel`;\n\nconst html = `<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>EVA Flow</title>\n</head>\n<body style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;background-color:#f5f5f7;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f5f5f7;padding:40px 20px;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.05);\">\n          <tr>\n            <td style=\"background-color:#1f2244;padding:30px;text-align:center;\">\n              <h1 style=\"color:#ffffff;margin:0;font-size:26px;font-weight:bold;letter-spacing:2px;\">EVA FLOW</h1>\n              <p style=\"color:#7dcef5;margin:8px 0 0 0;font-size:13px;\">Les Ateliers du Stream</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:40px 30px;\">\n              <h2 style=\"color:#1f2244;margin:0 0 20px 0;font-size:22px;\">Bienvenue, ${directorName} !</h2>\n              <p style=\"color:#333333;font-size:16px;line-height:1.6;margin:0 0 16px 0;\">\n                Vous venez d'\\u00eatre ajout\\u00e9(e) \\u00e0 <strong>EVA Flow</strong>, l'outil de planification des captations vid\\u00e9o des Ateliers du Stream.\n              </p>\n              <p style=\"color:#333333;font-size:16px;line-height:1.6;margin:0 0 24px 0;\">\n                Cliquez sur le bouton ci-dessous pour acc\\u00e9der \\u00e0 votre calendrier personnel et indiquer vos disponibilit\\u00e9s :\n              </p>\n              <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:30px auto;\">\n                <tr>\n                  <td style=\"background-color:#7dcef5;border-radius:6px;\">\n                    <a href=\"${magicLink}\" style=\"display:inline-block;padding:14px 32px;color:#1f2244;text-decoration:none;font-weight:bold;font-size:16px;\">\n                      Acc\\u00e9der \\u00e0 mon calendrier\n                    </a>\n                  </td>\n                </tr>\n              </table>\n              <p style=\"color:#727485;font-size:14px;line-height:1.6;margin:24px 0 0 0;padding:16px;background-color:#f5f5f7;border-radius:6px;border-left:3px solid #7dcef5;\">\n                <strong>Important :</strong> conservez ce mail pr\\u00e9cieusement. Ce lien est votre acc\\u00e8s personnel et ne doit pas \\u00eatre partag\\u00e9.\n              </p>\n              <p style=\"color:#727485;font-size:13px;line-height:1.6;margin:16px 0 0 0;\">\n                Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br>\n                <a href=\"${magicLink}\" style=\"color:#1f2244;word-break:break-all;\">${magicLink}</a>\n              </p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"background-color:#f5f5f7;padding:20px 30px;text-align:center;border-top:1px solid #e5e5e5;\">\n              <p style=\"color:#727485;font-size:12px;margin:0;\">\n                Les Ateliers du Stream &middot; EVA Flow<br>\n                <a href=\"https://evaremote.com\" style=\"color:#727485;text-decoration:none;\">evaremote.com</a>\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    to: to,\n    subject: subject,\n    html: html\n  }\n}];"
      },
